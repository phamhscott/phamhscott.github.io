---
// blog/index.astro — lists all your posts (the "/blog" page).
//
// getCollection() reads every file in the "blog" collection we defined in
// src/content.config.ts. We hide drafts, sort newest-first, then render a list.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<BaseLayout title="Blog — Scott" description="Writing and notes.">
  <section class="section">
    <h1>Blog</h1>

    {posts.length === 0 && <p>No posts yet — check back soon!</p>}

    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            {/* post.id comes from the filename, e.g. "hello-world". */}
            <a href={`/blog/${post.id}/`} class="post-link">
              <span class="post-title">{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </a>
            <p class="post-desc">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .section {
    margin-block: var(--space-md) var(--space-lg);
  }
  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .post-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    color: var(--text);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .post-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .post-link time {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 400;
    flex-shrink: 0; /* keep the date on one line */
  }
  .post-desc {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
  }
</style>
