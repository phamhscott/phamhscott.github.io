---
// blog/[...id].astro — the template for a SINGLE post.
//
// The square-bracket filename makes this a "dynamic route": one file that
// generates a page for every post. Two pieces make that work:
//   1. getStaticPaths() lists which pages to build (one per post).
//   2. render() compiles a post's Markdown into a <Content /> component.
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Runs at build time. For each post, we return its URL params + the post data.
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id }, // fills the [...id] slot in the URL
    props: { post }, // handed to this component as Astro.props
  }));
}

// CollectionEntry<"blog"> is the fully-typed shape of one blog post.
interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;

// Turn the Markdown body into a component we can render below.
const { Content } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
>
  <Content />
</BlogPostLayout>
