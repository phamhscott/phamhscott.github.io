---
// Footer.astro — shown at the bottom of every page (via BaseLayout).
// This runs at build time, so `year` is baked in when the site is built.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} Scott </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-md);
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .site-footer p {
    margin: 0;
  }
</style>
